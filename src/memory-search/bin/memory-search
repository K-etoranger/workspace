#!/usr/bin/env python3
"""memory-search build [--out <置き場>]"""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VENV = ROOT / ".venv"
if Path(sys.prefix).resolve() != VENV.resolve():
    # sqlite-vec はこの repo の .venv にある
    os.execv(VENV / "bin/python", [str(VENV / "bin/python"), __file__, *sys.argv[1:]])
sys.path.insert(0, str(ROOT))

if len(sys.argv) < 2 or sys.argv[1] != "build":
    print(__doc__, file=sys.stdout if sys.argv[1:2] in (["-h"], ["--help"]) else sys.stderr)
    sys.exit(0 if sys.argv[1:2] in (["-h"], ["--help"]) else 1)
from memory_search.build import main

sys.exit(main(sys.argv[2:]))
