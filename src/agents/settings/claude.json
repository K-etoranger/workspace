{
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Edit(//Users/taro/.ssh/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/taro/Workspace/src/agents/hooks/memory_recall.py",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/taro/Workspace/src/agents/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
