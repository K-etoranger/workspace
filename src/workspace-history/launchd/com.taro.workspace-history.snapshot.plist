<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.taro.workspace-history.snapshot</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/taro/Workspace/src/workspace-history/workspace-history</string>
		<string>--agent</string>
		<string>launchd</string>
		<string>Hourly snapshot</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/taro/Workspace/logs/workspace-history.snapshot.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/taro/Workspace/logs/workspace-history.snapshot.log</string>
	<key>StartInterval</key>
	<integer>3600</integer>
</dict>
</plist>
